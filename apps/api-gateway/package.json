{
  "name": "@awas-ai/api-gateway",
  "version": "1.0.0",
  "description": "API Gateway for AWAS-AI platform - handles routing, auth, rate limiting",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@awas-ai/config": "^1.0.0",
    "@awas-ai/types": "^1.0.0",
    "@awas-ai/shared": "^1.0.0",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^6.10.0",
    "jsonwebtoken": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "winston": "^3.10.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "express-validator": "^7.0.1",
    "http-status-codes": "^2.2.0",
    "redis": "^4.6.8",
    "socket.io": "^4.7.2",
    "prom-client": "^14.2.0",
    "joi": "^17.10.0",
    "uuid": "^9.0.0",
    "axios": "^1.5.0",
    "http-proxy-middleware": "^2.0.6"
